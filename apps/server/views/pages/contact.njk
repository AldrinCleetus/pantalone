{% extends "layout.njk" %}

{% block content %}
<div class="wrap prose-page">
  <section class="page-intro">
    <h1 class="page-title">Contact</h1>
    <p class="sub">Questions about sizing, custom builds, or an existing order? Reach me directly.</p>
  </section>

  <div class="prose-card">
    <h2>Get in touch</h2>
    <p>
      For custom props or sizing questions, the fastest way is the <a href="/custom-order">custom order form</a> so your reference link and dimensions stay attached to one request.
    </p>
    <p>
      For existing orders, keep your order number (like <code>KM-26-XXXXXX</code>) handy so I can check your print queue status right away.
    </p>
  </div>
</div>
{% endblock %}

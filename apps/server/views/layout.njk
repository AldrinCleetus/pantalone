<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="color-scheme" content="light dark">
  <script nonce="{{ cspNonce }}">
    try {
      var s = localStorage.getItem("color-scheme");
      if (s === "light" || s === "dark") {
        document.querySelector('meta[name="color-scheme"]').content = s;
        document.documentElement.setAttribute("data-theme", s);
      }
    } catch (e) {}
  </script>
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDescription }}">
  <link rel="canonical" href="{{ canonicalUrl }}">
  {% if noindex %}
  <meta name="robots" content="noindex, nofollow">
  {% endif %}
  <meta property="og:site_name" content="{{ store.name }}">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ pageDescription }}">
  <meta property="og:type" content="{{ ogType | default('website') }}">
  <meta property="og:url" content="{{ canonicalUrl }}">
  <meta property="og:image" content="{{ ogImageUrl }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ pageTitle }}">
  <meta name="twitter:description" content="{{ pageDescription }}">
  <meta name="twitter:image" content="{{ ogImageUrl }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bagel+Fat+One&family=Figtree:wght@400;600;700&family=Caveat:wght@600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/store.css">
  {% block headExtra %}{% endblock %}
  {% block jsonLd %}{% endblock %}
</head>
<body>
  <a href="#main-content" class="skip-link visually-hidden">Skip to main content</a>
  <header class="wrap site-header">
    <a class="logo" href="/">
      {% if store.nameParts.rest %}
        {{ store.nameParts.first }}<span>{{ store.nameParts.rest }}</span>
      {% else %}
        <span>{{ store.name }}</span>
      {% endif %}
    </a>
    <nav class="primary-nav" aria-label="Primary">
      <a href="/shop" {% if activeNav == 'shop' %}aria-current="page"{% endif %}>Shop</a>
      <a href="/custom-order" {% if activeNav == 'custom' %}aria-current="page"{% endif %}>Custom orders</a>
      <a href="/about" {% if activeNav == 'about' %}aria-current="page"{% endif %}>About</a>
      <a class="cart-pill" href="/cart" data-cart-count {% if activeNav == 'cart' %}aria-current="page"{% endif %}>Cart (0)</a>
    </nav>
  </header>

  <main id="main-content">
    {% block content %}{% endblock %}
  </main>

  <footer class="wrap site-footer">
    <div>
      <div class="hand">Thanks for supporting a one-person shop.</div>
      <div>{{ store.name }} · Ships across India. Pay by UPI, card or net banking.</div>
    </div>
    <div class="footer-links">
      <a href="/shop">Shop</a>
      <a href="/custom-order">Custom orders</a>
      <a href="/shipping-returns">Shipping &amp; returns</a>
      <a href="/contact">Contact</a>
      <button class="theme-btn" id="theme-toggle" type="button">Switch to dark theme</button>
    </div>
  </footer>

  <div class="toast" id="toast" role="status" aria-live="polite">Added to cart</div>
  <script type="module" src="/js/store.js"></script>
  {% block scripts %}{% endblock %}
</body>
</html>

{
  "name": "project-pantalone",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm --workspace=apps/server run dev",
    "build": "npm --workspace=apps/server run build",
    "start": "npm --workspace=apps/server run start",
    "typecheck": "npm --workspace=apps/server run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "npm --workspace=apps/server run db:generate",
    "db:migrate": "npm --workspace=apps/server run db:migrate",
    "db:seed": "npm --workspace=apps/server run db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1"
  }
}
